{
  "name": "live-drop",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && cp src/services/*.js dist/services/ 2>/dev/null || true",
    "migrate": "node scripts/migrate.js all",
    "migrate:init": "node scripts/migrate.js 001_init.sql",
    "migrate:streamer": "node scripts/migrate.js 002_add_streamer.sql"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.3",
    "puppeteer": "^23.5.0",
    "ws": "^8.18.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^10.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
