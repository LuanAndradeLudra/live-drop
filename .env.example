NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/live_drop?schema=public

# JOBS
JOBS_DEFAULT_BATCH=5
JOBS_MAX_TRIES=3

# Limite de rolls em fila (queued). Novos POST /api/rolls recebem 429. 0 = sem limite.
# MAX_QUEUED_ROLLS=80

# Processing preso: volta para queued após N minutos sem atualizar. 0 = desliga (default 15).
# STALE_PROCESSING_MINUTES=15

# Intervalo do cron que verifica processing preso (ms). Default 90000 (90s).
# STALE_PROCESSING_INTERVAL_MS=90000

# Páginas Puppeteer em paralelo (default 12).
# PPTR_MAX_PAGES=12
